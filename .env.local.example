# ===========================================================================
#  MODELO — copie para .env.local e preencha lá.
#  NUNCA coloque chaves reais NESTE arquivo: ele não é ignorado pelo git.
#  Guia completo: docs/SUPABASE.md
# ===========================================================================

# Project Settings › API › Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings › API Keys › publishable (ou "anon public" nos projetos antigos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings › API Keys › secret (ou "service_role")
# Ignora TODO o RLS. Só use em rotas de servidor. Nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Modo de operação
# ---------------------------------------------------------------------------
# Vazio (ou "false"): usa o Supabase quando configurado, e a chave
#   "Supabase / Demo" na interface permite alternar a qualquer momento.
# "true": TRAVA o modo demonstração para todo mundo e esconde a chave.
#   Útil num ambiente só de apresentação.
NEXT_PUBLIC_MODO_DEMO=

# ---------------------------------------------------------------------------
# Tino — assistente de IA (docs/N8N-TINO.md)
# ---------------------------------------------------------------------------
# URL do webhook do n8n (Production URL do nó Webhook).
# Sem isso, o assistente usa um atendimento de reserva local que consulta o
# catálogo real do Supabase e responde por regras — funciona, mas não é IA.
# Sem prefixo NEXT_PUBLIC_ de propósito: só é lida no servidor.
N8N_WEBHOOK_URL=

# URL do webhook que gera as questões da AULA (n8n/tino-questoes.json).
# Sem isso, o botão "Gerar 5 perguntas" cai num modelo local sem IA, que serve
# só de esqueleto para o admin reescrever. Ver docs/N8N-TINO.md.
N8N_QUESTOES_WEBHOOK_URL=

# URL do webhook que gera as questões do BANCO, usado em /admin/questoes/gerar.
# Se ficar vazia, a rota tenta N8N_QUESTOES_WEBHOOK_URL antes de desistir.
N8N_QUESTOES_BANCO_WEBHOOK_URL=

# --------------------------------------------------------------------------
# A PONTE DE IA  (n8n/tino-ia.json) — recomendada
# --------------------------------------------------------------------------
# As três variáveis acima (questões da aula, questões do banco e feedback do
# simulado) podem apontar TODAS para o mesmo webhook: `/webhook/tino-ia`.
#
# A ponte é um fluxo de três nós que recebe { system, user, max_tokens } e
# devolve { resposta }. O prompt é montado na aplicação, onde fica versionado
# e revisável — o n8n só guarda a credencial da Anthropic e repassa.
#
# As rotas mandam os dois formatos no mesmo corpo (`tipo`/`area` para os
# fluxos antigos e `system`/`user` para a ponte), então trocar de fluxo é
# trocar a URL aqui, sem mexer em código.
#
# Webhook que responde a análise do simulado em /app/questoes/simulados.
# Sem ela, a rota tenta o fluxo do assistente (N8N_WEBHOOK_URL) e, por último,
# uma análise local por regras.
N8N_FEEDBACK_WEBHOOK_URL=

# Alternativa ao n8n para desenvolver: chama a API da Anthropic direto do
# servidor. Se as duas estiverem preenchidas, o n8n tem prioridade.
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-sonnet-5
ANTHROPIC_MODEL=

# URL do webhook que responde as dúvidas dentro da aula (n8n/tino-duvidas.json).
# Sem isso, a aba "Tirar dúvida com IA" devolve uma resposta honesta dizendo que
# a IA não está conectada e encaminha para o fórum e o WhatsApp.
# Se ficar vazia, a rota tenta N8N_WEBHOOK_URL antes de desistir.
N8N_DUVIDAS_WEBHOOK_URL=

# Webhook da dúvida com IA dentro de uma questão do banco (/app/questoes).
# Pode apontar para a MESMA ponte de IA (/webhook/tino-ia): o prompt é montado
# na aplicação e o fluxo só repassa para o modelo.
# Se ficar vazia, a rota tenta N8N_QUESTOES_WEBHOOK_URL e depois
# ANTHROPIC_API_KEY, antes de cair numa explicação montada a partir do gabarito.
N8N_DUVIDA_QUESTAO_WEBHOOK_URL=
